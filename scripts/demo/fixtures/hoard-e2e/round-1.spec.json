{
  "$schema": "https://designer.hfps.dev/schema/wireframe-spec.schema.json",
  "version": 1,
  "name": "Hoard",
  "screens": [
    {
      "name": "Galeria",
      "status": "current",
      "platform": "phone",
      "root": [
        { "hstack": [
            { "heading": { "text": "Galeria", "level": "title" } },
            { "icon": { "icon": "search" } },
            { "icon": { "icon": "smartphone" } },
            { "icon": { "icon": "calendar" } },
            { "icon": { "icon": "filter" } },
            { "icon": { "icon": "trash-2" } },
            { "icon": { "icon": "settings" }, "id": "gallery-settings", "opens": "Configurações" }
          ], "gap": 16 },
        { "vstack": [
            { "hstack": [ { "icon": { "icon": "smartphone" } }, { "heading": { "text": "Backup de SM-S928B", "level": "subheading" } }, { "icon": { "icon": "x" } } ], "gap": 12 },
            { "section-header": { "label": "Domingo, 25 de outubro de 2026", "action": "9" } },
            { "grid": [ { "image": { "ratio": "1:1", "subject": "screenshot do celular" } } ], "columns": 4, "gap": 4, "repeat": 9 },
            { "section-header": { "label": "Sábado, 24 de outubro de 2026", "action": "12" } },
            { "grid": [ { "image": { "ratio": "1:1", "subject": "screenshot do celular" } } ], "columns": 4, "gap": 4, "repeat": 12 }
          ], "style": "outline", "radius": "large", "padding": 12, "gap": 8 },
        { "bottom-navigation": { "labels": ["Galeria", "Arquivos"], "selected": 1, "icon1": "images", "icon2": "folder" } }
      ]
    },
    {
      "name": "Configurações",
      "status": "current",
      "platform": "phone",
      "root": [
        { "top-app-bar": { "title": "Configurações", "leading": "back", "actions": 0 }, "id": "settings-back", "opens": "Galeria" },
        { "vstack": [
            { "section-header": "SERVIDOR DE FOTOS" },
            { "text": { "text": "O hoard-server guarda sua biblioteca: o Hoard mostra os itens dele na Galeria e sincroniza suas escolhas e estrelas com o Reveal e a galeria web.", "tone": "muted" } },
            { "list-row": { "title": "Reveal sync", "subtitle": "Versão 0.12.1 · https://cachyos-fps.tail33e6…", "leading": "icon", "leadingIcon": "lock", "trailing": "value", "value": "Endereço", "divider": true } },
            { "list-row": { "title": "Situação", "subtitle": "Sincronizado Há 0 minuto…", "leading": "icon", "leadingIcon": "circle-check", "trailing": "none", "divider": true } },
            { "list-row": { "title": "Este celular", "subtitle": "Agrupado com reveal", "leading": "icon", "leadingIcon": "smartphone", "trailing": "none", "divider": true } },
            { "list-row": { "title": "Backup do celular", "subtitle": "1 pasta · 0 de 0 com backup · 83,7 MB liberados · 159 arquivos", "leading": "icon", "leadingIcon": "upload", "trailing": "none", "divider": true } },
            { "list-row": { "title": "Cache de prévias", "subtitle": "51 MB de 1,1 GB", "leading": "icon", "leadingIcon": "database", "trailing": "value", "value": "Limpar cache" } },
            { "radio-group": { "label": "Limite do cache", "options": ["268 MB", "1,1 GB", "4,3 GB"], "selected": 2 } },
            { "list-row": { "title": "Miniaturas offline", "subtitle": "14501 de 14497 itens · 136 MB", "leading": "icon", "leadingIcon": "images", "trailing": "value", "value": "Limpar cache" } },
            { "checkbox": { "label": "Guardar miniaturas pequenas da biblioteca inteira (só no Wi-Fi)", "checked": true } }
          ], "style": "outline", "radius": "large", "padding": 12, "gap": 4 }
      ]
    }
  ]
}
