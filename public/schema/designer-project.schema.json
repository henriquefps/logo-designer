{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://designer.hfps.dev/schema/designer-project.schema.json",
  "title": "Designer project (.designer.json)",
  "description": "A Designer (https://designer.hfps.dev) project file. Field reference: https://github.com/henriquefps/logo-designer/blob/main/docs/project-format.md",
  "$ref": "#/definitions/DesignerProjectFile",
  "definitions": {
    "DesignerProjectFile": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "Points editors at the JSON Schema: https://designer.hfps.dev/schema/designer-project.schema.json"
        },
        "format": {
          "type": "string",
          "const": "designer",
          "description": "Always \"designer\"."
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "createdAt": {
          "type": "number"
        },
        "updatedAt": {
          "type": "number"
        },
        "artboard": {
          "$ref": "#/definitions/Artboard"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SceneNode"
          }
        },
        "icon": {
          "$ref": "#/definitions/IconDocInfo",
          "description": "Present only on app icon documents."
        },
        "wireframe": {
          "$ref": "#/definitions/WireframeDocInfo",
          "description": "Present only on wireframe documents."
        }
      },
      "required": [
        "artboard",
        "children",
        "schemaVersion"
      ],
      "description": "A Designer project file (`*.designer.json`)."
    },
    "Id": {
      "type": "string"
    },
    "Artboard": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "background": {
          "$ref": "#/definitions/Paint"
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "Paint": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "solid"
            },
            "color": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "description": "#rrggbb or #rrggbbaa"
            }
          },
          "required": [
            "kind",
            "color"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "linear",
                "radial"
              ]
            },
            "stops": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GradientStop"
              }
            },
            "angle": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "stops"
          ]
        }
      ]
    },
    "GradientStop": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "number"
        },
        "color": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "#rrggbb or #rrggbbaa"
        }
      },
      "required": [
        "offset",
        "color"
      ]
    },
    "SceneNode": {
      "anyOf": [
        {
          "$ref": "#/definitions/GroupNode"
        },
        {
          "$ref": "#/definitions/PathNode"
        },
        {
          "$ref": "#/definitions/RectNode"
        },
        {
          "$ref": "#/definitions/EllipseNode"
        },
        {
          "$ref": "#/definitions/PolygonNode"
        },
        {
          "$ref": "#/definitions/TextNode"
        },
        {
          "$ref": "#/definitions/ImageNode"
        }
      ]
    },
    "GroupNode": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "group"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SceneNode"
          }
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "reference": {
          "type": "boolean",
          "description": "Tracing reference: drawn, but never hit-tested, snapped to or exported. Absent = false."
        },
        "opacity": {
          "type": "number"
        },
        "blendMode": {
          "type": "string"
        },
        "transform": {
          "$ref": "#/definitions/Transform"
        },
        "screen": {
          "$ref": "#/definitions/ScreenFrameInfo",
          "description": "Wireframe documents only: this top-level group is a screen frame (see src/wireframe)."
        },
        "component": {
          "$ref": "#/definitions/ComponentInfo",
          "description": "Wireframe documents only: this group is a component instance; its children are generated."
        },
        "layout": {
          "$ref": "#/definitions/LayoutInfo",
          "description": "Wireframe documents only: this group lays out its children (stack / grid, src/wireframe/layout.ts)."
        },
        "layoutItem": {
          "$ref": "#/definitions/LayoutItemInfo",
          "description": "Wireframe documents only: how this node sits in its parent's `layout`."
        },
        "note": {
          "$ref": "#/definitions/NoteInfo",
          "description": "Wireframe documents only: this top-level group is a note (a sticky, optionally attached to a node)."
        }
      },
      "required": [
        "children",
        "type"
      ]
    },
    "Transform": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "rotation": {
          "type": "number"
        },
        "scaleX": {
          "type": "number"
        },
        "scaleY": {
          "type": "number"
        }
      },
      "description": "Node is drawn at translate(x,y) rotate(rotation) scale(scaleX,scaleY) around its local origin."
    },
    "ScreenFrameInfo": {
      "type": "object",
      "properties": {
        "screenId": {
          "$ref": "#/definitions/Id",
          "description": "The logical screen (`DesignDocument.wireframe.screens[].id`) this frame is a variant of."
        },
        "platform": {
          "$ref": "#/definitions/ScreenPlatform"
        },
        "width": {
          "type": "number",
          "description": "Frame width (default: the platform width; editable for an odd case)."
        },
        "height": {
          "type": "number",
          "description": "Frame height, written by the wireframe pipeline: never below the platform minimum."
        }
      },
      "description": "A screen frame: a top-level group drawn as a device frame (white, thin border, name above). Local origin = the frame's top-left corner; the frame spans 0..width × 0..height and clips its children on export. `height` is materialized: max(platform minimum, content)."
    },
    "ScreenPlatform": {
      "type": "string",
      "enum": [
        "phone",
        "tablet",
        "desktop"
      ],
      "description": "Device class of a screen frame. Kept deliberately few: no device list, no orientations."
    },
    "ComponentInfo": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "description": "Library kind, e.g. `list-row` (src/wireframe/library/<kind>/index.ts)."
        },
        "props": {
          "$ref": "#/definitions/Record%3Cstring%2Cunknown%3E",
          "description": "Prop values (missing props take the definition's defaults)."
        },
        "size": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "width",
            "height"
          ],
          "description": "The box the children were built for (local origin = top-left). Omitted = the definition's default size."
        }
      },
      "required": [
        "kind"
      ],
      "description": "A semantic component instance: `build(props, size)` of the library kind generates the group's children."
    },
    "Record<string,unknown>": {
      "type": "object",
      "additionalProperties": {}
    },
    "LayoutInfo": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/LayoutKind"
        },
        "gap": {
          "type": "number",
          "description": "Space between children."
        },
        "padding": {
          "type": "number",
          "description": "Inner padding on every side."
        },
        "align": {
          "$ref": "#/definitions/LayoutAlign",
          "description": "Cross-axis alignment of the children."
        },
        "columns": {
          "type": "number",
          "description": "Grid only: number of columns."
        },
        "size": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "width",
            "height"
          ],
          "description": "The container's box (local origin = top-left), written by the layout step. Screen frames keep theirs in `screen` instead. Omitted = not laid out yet (the layout step measures the content)."
        }
      },
      "required": [
        "kind"
      ],
      "description": "Container layout (src/wireframe/layout.ts). The container's local origin is its top-left corner."
    },
    "LayoutKind": {
      "type": "string",
      "enum": [
        "vstack",
        "hstack",
        "grid"
      ]
    },
    "LayoutAlign": {
      "type": "string",
      "enum": [
        "start",
        "center",
        "end",
        "stretch"
      ]
    },
    "LayoutItemInfo": {
      "type": "object",
      "properties": {
        "width": {
          "$ref": "#/definitions/LayoutSize"
        },
        "height": {
          "$ref": "#/definitions/LayoutSize"
        },
        "position": {
          "type": "string",
          "enum": [
            "flow",
            "pinned-bottom",
            "free"
          ],
          "description": "`flow` (default): placed by the stack. `pinned-bottom`: at the bottom of the screen. `free`: absolute, ignored by the stack."
        }
      },
      "description": "A child's sizing inside a layout container. Missing fields take the defaults (component `sizing`, containers fill × hug)."
    },
    "LayoutSize": {
      "anyOf": [
        {
          "type": "string",
          "const": "fill"
        },
        {
          "type": "string",
          "const": "hug"
        },
        {
          "type": "number"
        }
      ],
      "description": "`fill` the available space, `hug` the content, or a fixed size."
    },
    "NoteInfo": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "target": {
          "$ref": "#/definitions/Id",
          "description": "The node this note is attached to. Absent = a free note. Cleared when that node is deleted."
        }
      },
      "description": "A note: a sticky on the canvas (a top-level group; its children are generated from `text`), optionally attached to a node (`target`: any node id) by a connector line that follows both. Notes are not part of screen exports; they are part of the export for AI."
    },
    "PathNode": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "path"
        },
        "subpaths": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SubPath"
          }
        },
        "fillRule": {
          "type": "string",
          "enum": [
            "nonzero",
            "evenodd"
          ]
        },
        "fill": {
          "$ref": "#/definitions/Paint"
        },
        "stroke": {
          "$ref": "#/definitions/Stroke"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "reference": {
          "type": "boolean",
          "description": "Tracing reference: drawn, but never hit-tested, snapped to or exported. Absent = false."
        },
        "opacity": {
          "type": "number"
        },
        "blendMode": {
          "type": "string"
        },
        "transform": {
          "$ref": "#/definitions/Transform"
        },
        "screen": {
          "$ref": "#/definitions/ScreenFrameInfo",
          "description": "Wireframe documents only: this top-level group is a screen frame (see src/wireframe)."
        },
        "component": {
          "$ref": "#/definitions/ComponentInfo",
          "description": "Wireframe documents only: this group is a component instance; its children are generated."
        },
        "layout": {
          "$ref": "#/definitions/LayoutInfo",
          "description": "Wireframe documents only: this group lays out its children (stack / grid, src/wireframe/layout.ts)."
        },
        "layoutItem": {
          "$ref": "#/definitions/LayoutItemInfo",
          "description": "Wireframe documents only: how this node sits in its parent's `layout`."
        },
        "note": {
          "$ref": "#/definitions/NoteInfo",
          "description": "Wireframe documents only: this top-level group is a note (a sticky, optionally attached to a node)."
        }
      },
      "required": [
        "subpaths",
        "type"
      ]
    },
    "SubPath": {
      "type": "object",
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BezierPoint"
          }
        },
        "closed": {
          "type": "boolean"
        }
      },
      "required": [
        "points"
      ]
    },
    "BezierPoint": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "in": {
          "$ref": "#/definitions/Vec"
        },
        "out": {
          "$ref": "#/definitions/Vec"
        },
        "type": {
          "$ref": "#/definitions/PointType"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "description": "in/out handles are absolute in local coords."
    },
    "Vec": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "PointType": {
      "type": "string",
      "enum": [
        "corner",
        "smooth",
        "symmetric"
      ]
    },
    "Stroke": {
      "type": "object",
      "properties": {
        "paint": {
          "$ref": "#/definitions/Paint"
        },
        "width": {
          "type": "number"
        },
        "cap": {
          "$ref": "#/definitions/LineCap"
        },
        "join": {
          "$ref": "#/definitions/LineJoin"
        },
        "dash": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "paint",
        "width"
      ]
    },
    "LineCap": {
      "type": "string",
      "enum": [
        "butt",
        "round",
        "square"
      ]
    },
    "LineJoin": {
      "type": "string",
      "enum": [
        "miter",
        "round",
        "bevel"
      ]
    },
    "RectNode": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "rect"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "radius": {
          "type": "number"
        },
        "fill": {
          "$ref": "#/definitions/Paint"
        },
        "stroke": {
          "$ref": "#/definitions/Stroke"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "reference": {
          "type": "boolean",
          "description": "Tracing reference: drawn, but never hit-tested, snapped to or exported. Absent = false."
        },
        "opacity": {
          "type": "number"
        },
        "blendMode": {
          "type": "string"
        },
        "transform": {
          "$ref": "#/definitions/Transform"
        },
        "screen": {
          "$ref": "#/definitions/ScreenFrameInfo",
          "description": "Wireframe documents only: this top-level group is a screen frame (see src/wireframe)."
        },
        "component": {
          "$ref": "#/definitions/ComponentInfo",
          "description": "Wireframe documents only: this group is a component instance; its children are generated."
        },
        "layout": {
          "$ref": "#/definitions/LayoutInfo",
          "description": "Wireframe documents only: this group lays out its children (stack / grid, src/wireframe/layout.ts)."
        },
        "layoutItem": {
          "$ref": "#/definitions/LayoutItemInfo",
          "description": "Wireframe documents only: how this node sits in its parent's `layout`."
        },
        "note": {
          "$ref": "#/definitions/NoteInfo",
          "description": "Wireframe documents only: this top-level group is a note (a sticky, optionally attached to a node)."
        }
      },
      "required": [
        "height",
        "type",
        "width"
      ],
      "description": "Centered on its local origin: spans -width/2..width/2, -height/2..height/2."
    },
    "EllipseNode": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ellipse"
        },
        "rx": {
          "type": "number"
        },
        "ry": {
          "type": "number"
        },
        "fill": {
          "$ref": "#/definitions/Paint"
        },
        "stroke": {
          "$ref": "#/definitions/Stroke"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "reference": {
          "type": "boolean",
          "description": "Tracing reference: drawn, but never hit-tested, snapped to or exported. Absent = false."
        },
        "opacity": {
          "type": "number"
        },
        "blendMode": {
          "type": "string"
        },
        "transform": {
          "$ref": "#/definitions/Transform"
        },
        "screen": {
          "$ref": "#/definitions/ScreenFrameInfo",
          "description": "Wireframe documents only: this top-level group is a screen frame (see src/wireframe)."
        },
        "component": {
          "$ref": "#/definitions/ComponentInfo",
          "description": "Wireframe documents only: this group is a component instance; its children are generated."
        },
        "layout": {
          "$ref": "#/definitions/LayoutInfo",
          "description": "Wireframe documents only: this group lays out its children (stack / grid, src/wireframe/layout.ts)."
        },
        "layoutItem": {
          "$ref": "#/definitions/LayoutItemInfo",
          "description": "Wireframe documents only: how this node sits in its parent's `layout`."
        },
        "note": {
          "$ref": "#/definitions/NoteInfo",
          "description": "Wireframe documents only: this top-level group is a note (a sticky, optionally attached to a node)."
        }
      },
      "required": [
        "rx",
        "ry",
        "type"
      ],
      "description": "Centered on its local origin."
    },
    "PolygonNode": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "polygon"
        },
        "sides": {
          "type": "number"
        },
        "radius": {
          "type": "number"
        },
        "innerRadius": {
          "type": "number"
        },
        "fill": {
          "$ref": "#/definitions/Paint"
        },
        "stroke": {
          "$ref": "#/definitions/Stroke"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "reference": {
          "type": "boolean",
          "description": "Tracing reference: drawn, but never hit-tested, snapped to or exported. Absent = false."
        },
        "opacity": {
          "type": "number"
        },
        "blendMode": {
          "type": "string"
        },
        "transform": {
          "$ref": "#/definitions/Transform"
        },
        "screen": {
          "$ref": "#/definitions/ScreenFrameInfo",
          "description": "Wireframe documents only: this top-level group is a screen frame (see src/wireframe)."
        },
        "component": {
          "$ref": "#/definitions/ComponentInfo",
          "description": "Wireframe documents only: this group is a component instance; its children are generated."
        },
        "layout": {
          "$ref": "#/definitions/LayoutInfo",
          "description": "Wireframe documents only: this group lays out its children (stack / grid, src/wireframe/layout.ts)."
        },
        "layoutItem": {
          "$ref": "#/definitions/LayoutItemInfo",
          "description": "Wireframe documents only: how this node sits in its parent's `layout`."
        },
        "note": {
          "$ref": "#/definitions/NoteInfo",
          "description": "Wireframe documents only: this top-level group is a note (a sticky, optionally attached to a node)."
        }
      },
      "required": [
        "radius",
        "sides",
        "type"
      ],
      "description": "Centered on its local origin; first vertex points up. Star when innerRadius is set."
    },
    "TextNode": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        },
        "text": {
          "type": "string"
        },
        "fontFamily": {
          "type": "string"
        },
        "fontWeight": {
          "type": "number"
        },
        "fontStyle": {
          "type": "string",
          "enum": [
            "normal",
            "italic"
          ]
        },
        "fontSize": {
          "type": "number"
        },
        "letterSpacing": {
          "type": "number"
        },
        "lineHeight": {
          "type": "number"
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "fill": {
          "$ref": "#/definitions/Paint"
        },
        "stroke": {
          "$ref": "#/definitions/Stroke"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "reference": {
          "type": "boolean",
          "description": "Tracing reference: drawn, but never hit-tested, snapped to or exported. Absent = false."
        },
        "opacity": {
          "type": "number"
        },
        "blendMode": {
          "type": "string"
        },
        "transform": {
          "$ref": "#/definitions/Transform"
        },
        "screen": {
          "$ref": "#/definitions/ScreenFrameInfo",
          "description": "Wireframe documents only: this top-level group is a screen frame (see src/wireframe)."
        },
        "component": {
          "$ref": "#/definitions/ComponentInfo",
          "description": "Wireframe documents only: this group is a component instance; its children are generated."
        },
        "layout": {
          "$ref": "#/definitions/LayoutInfo",
          "description": "Wireframe documents only: this group lays out its children (stack / grid, src/wireframe/layout.ts)."
        },
        "layoutItem": {
          "$ref": "#/definitions/LayoutItemInfo",
          "description": "Wireframe documents only: how this node sits in its parent's `layout`."
        },
        "note": {
          "$ref": "#/definitions/NoteInfo",
          "description": "Wireframe documents only: this top-level group is a note (a sticky, optionally attached to a node)."
        }
      },
      "required": [
        "fontSize",
        "text",
        "type"
      ],
      "description": "Local origin is the anchor of the first line's top edge, at left/center/right per `align`."
    },
    "ImageNode": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "image"
        },
        "href": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "reference": {
          "type": "boolean",
          "description": "Tracing reference: drawn, but never hit-tested, snapped to or exported. Absent = false."
        },
        "opacity": {
          "type": "number"
        },
        "blendMode": {
          "type": "string"
        },
        "transform": {
          "$ref": "#/definitions/Transform"
        },
        "screen": {
          "$ref": "#/definitions/ScreenFrameInfo",
          "description": "Wireframe documents only: this top-level group is a screen frame (see src/wireframe)."
        },
        "component": {
          "$ref": "#/definitions/ComponentInfo",
          "description": "Wireframe documents only: this group is a component instance; its children are generated."
        },
        "layout": {
          "$ref": "#/definitions/LayoutInfo",
          "description": "Wireframe documents only: this group lays out its children (stack / grid, src/wireframe/layout.ts)."
        },
        "layoutItem": {
          "$ref": "#/definitions/LayoutItemInfo",
          "description": "Wireframe documents only: how this node sits in its parent's `layout`."
        },
        "note": {
          "$ref": "#/definitions/NoteInfo",
          "description": "Wireframe documents only: this top-level group is a note (a sticky, optionally attached to a node)."
        }
      },
      "required": [
        "height",
        "href",
        "type",
        "width"
      ],
      "description": "Centered on its local origin."
    },
    "IconDocInfo": {
      "type": "object",
      "properties": {
        "preset": {
          "$ref": "#/definitions/IconPreset",
          "description": "app-icon (128 tile), android-adaptive (108 canvas, 72 visible), ios (1024), favicon-32, favicon-16."
        },
        "shape": {
          "$ref": "#/definitions/IconShapeSetting",
          "description": "Keyline: auto detects square / wide / tall from the ink box; circle only when set."
        },
        "smallGlyphProjectId": {
          "type": "string",
          "description": "Project used for the 16/32/48 px favicon glyph (glyph-small.svg) instead of this one."
        },
        "tile": {
          "type": "string",
          "description": "Tile colour, #rrggbb (or #rgb); default #2063b0 (hfps blue). Older hfps repos keep olive #5b7a3a.",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        },
        "colour": {
          "$ref": "#/definitions/IconColourMode",
          "description": "\"one-colour\" (default): every paint becomes the glyph colour. \"full-colour\": the document's own paints (solids, gradients, opacity) are kept."
        },
        "glyph": {
          "type": "string",
          "description": "One-colour mode: the glyph colour, #rrggbb (or #rgb); default #ffffff (white). Ignored when colour is \"full-colour\".",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        }
      },
      "required": [
        "preset",
        "shape"
      ],
      "description": "Marks an app icon document (keylines, icon panel, icon-set export). See src/icon/."
    },
    "IconPreset": {
      "type": "string",
      "enum": [
        "app-icon",
        "android-adaptive",
        "ios",
        "favicon-32",
        "favicon-16"
      ]
    },
    "IconShapeSetting": {
      "type": "string",
      "enum": [
        "auto",
        "circle",
        "square",
        "wide",
        "tall"
      ]
    },
    "IconColourMode": {
      "type": "string",
      "enum": [
        "one-colour",
        "full-colour"
      ],
      "description": "one-colour: every paint becomes the glyph colour (default). full-colour: the document's own paints are kept."
    },
    "WireframeDocInfo": {
      "type": "object",
      "properties": {
        "screens": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WireframeScreen"
          },
          "description": "Logical screens, in creation order. Kept in sync with the frames by the wireframe pipeline."
        }
      },
      "description": "Marks a wireframe document: infinite canvas (the artboard is unused), screens, components."
    },
    "WireframeScreen": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "description": "A logical screen (`Settings`, `Gallery`): one or more frames, at most one per platform."
    }
  }
}
